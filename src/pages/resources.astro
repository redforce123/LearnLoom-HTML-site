        <div class="text-2xl font-extrabold text-[#EA0264]">100% Free</div>
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Instant Downloads</div>
      </div>
      <div class="bg-white/80 backdrop-blur-sm border border-slate-100 p-4 rounded-2xl shadow-sm">
