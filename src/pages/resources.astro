    <!-- FAQ Accordion Section for SEO -->
    <section class="max-w-4xl mx-auto mb-16">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Frequently Asked Questions</h2>
        <p class="text-sm text-slate-500 mt-1">Everything you need to know about our Olympiad question bank and resources</p>
      </div>

      <div class="space-y-3.5">
        {faqs.map((faq, idx) => (
          <details class="group bg-white/80 backdrop-blur-sm rounded-2xl border border-slate-200/70 p-5 open:shadow-md transition-all duration-200">
            <summary class="flex justify-between items-center cursor-pointer font-bold text-slate-800 text-base group-hover:text-[#EA0264] transition-colors list-none">
