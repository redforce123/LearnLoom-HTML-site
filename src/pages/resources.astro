  </main>

  <!-- Client-side Interactive Multi-dimensional Filter & Search Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('resource-search');
      const clearSearchBtn = document.getElementById('clear-search');
      const categoryButtons = document.querySelectorAll('[data-category-filter]');
      const streamButtons = document.querySelectorAll('[data-stream-filter]');
      const paperCards = document.querySelectorAll('.paper-card');
      const noResults = document.getElementById('no-results');
      const resetBtn = document.getElementById('reset-filters');
      const resultsHeading = document.getElementById('results-heading');
      const resultsCount = document.getElementById('results-count');

      let currentCategory = 'all';
      let currentStream = 'all';
      let currentQuery = '';

      function filterPapers() {
        let visibleCount = 0;
        const query = currentQuery.trim().toLowerCase();

        paperCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          const title = card.getAttribute('data-title') || '';
          const grade = card.getAttribute('data-grade') || '';
          const subjects = card.getAttribute('data-subjects') || '';
          const stream = card.getAttribute('data-stream') || '';

          const matchesCategory = (currentCategory === 'all' || cardCategory === currentCategory);
          const matchesStream = (currentStream === 'all' || stream.includes(currentStream.toLowerCase()));
          const matchesQuery = !query || 
            title.includes(query) || 
            grade.includes(query) || 
            subjects.includes(query) || 
            stream.includes(query);

          if (matchesCategory && matchesStream && matchesQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Update count & heading
        if (resultsCount) {
          resultsCount.textContent = `Showing ${visibleCount} of ${paperCards.length} examination papers`;
        }

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }

        // Toggle clear search button visibility
        if (clearSearchBtn) {
          if (query.length > 0) {
            clearSearchBtn.classList.remove('hidden');
          } else {
            clearSearchBtn.classList.add('hidden');
          }
        }
      }

      // Category tab click handler
      categoryButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          categoryButtons.forEach(b => {
            b.classList.remove('bg-gradient-to-r', 'from-[#FF2E93]', 'to-[#EA0264]', 'text-white', 'shadow-md', 'shadow-pink-500/20', 'active-tab');
            b.classList.add('bg-slate-100', 'text-slate-600');
            const badge = b.querySelector('span:last-child');
            if (badge) {
              badge.classList.remove('bg-white/25', 'text-white');
              badge.classList.add('bg-slate-200', 'text-slate-600');
            }
          });

          btn.classList.remove('bg-slate-100', 'text-slate-600');
          btn.classList.add('bg-gradient-to-r', 'from-[#FF2E93]', 'to-[#EA0264]', 'text-white', 'shadow-md', 'shadow-pink-500/20', 'active-tab');
          const badge = btn.querySelector('span:last-child');
          if (badge) {
            badge.classList.remove('bg-slate-200', 'text-slate-600');
            badge.classList.add('bg-white/25', 'text-white');
          }

          currentCategory = btn.getAttribute('data-category-filter') || 'all';
          filterPapers();
        });
      });

      // Stream tab click handler
      streamButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          streamButtons.forEach(b => {
            b.classList.remove('bg-slate-900', 'text-white', 'shadow-sm', 'active-stream');
            b.classList.add('bg-slate-100', 'text-slate-600');
            const badge = b.querySelector('span:last-child');
            if (badge) {
              badge.classList.remove('bg-white/20', 'text-white');
              badge.classList.add('bg-slate-200', 'text-slate-600');
            }
          });

          btn.classList.remove('bg-slate-100', 'text-slate-600');
          btn.classList.add('bg-slate-900', 'text-white', 'shadow-sm', 'active-stream');
          const badge = btn.querySelector('span:last-child');
          if (badge) {
            badge.classList.remove('bg-slate-200', 'text-slate-600');
            badge.classList.add('bg-white/20', 'text-white');
          }

          const streamId = btn.getAttribute('data-stream-filter');
          const streamName = btn.getAttribute('data-stream-name');
          currentStream = (streamId === 'all') ? 'all' : streamName;
          filterPapers();
        });
      });

      // Search input handler
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value;
          filterPapers();
        });
      }

      // Clear search button
      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            currentQuery = '';
            filterPapers();
            searchInput.focus();
          }
        });
      }

      // Reset button in empty state
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          const allCat = document.querySelector('[data-category-filter="all"]');
          if (allCat) allCat.click();
          const allStr = document.querySelector('[data-stream-filter="all"]');
          if (allStr) allStr.click();
        });
      }
    });
  </script>
</BaseLayout>
