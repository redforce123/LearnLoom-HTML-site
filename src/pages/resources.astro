      <div id="papers-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {papers.map((paper) => {
          // Dynamic badge styling based on stream
          let streamBadgeClass = "bg-slate-100 text-slate-700 border-slate-200";
          if (paper.stream === 'Computer Science') {
            streamBadgeClass = "bg-cyan-50 text-cyan-800 border-cyan-200/80";
          } else if (paper.stream === 'English Language') {
            streamBadgeClass = "bg-purple-50 text-purple-800 border-purple-200/80";
          } else if (paper.stream === 'Hindi Language') {
            streamBadgeClass = "bg-emerald-50 text-emerald-800 border-emerald-200/80";
          } else if (paper.stream === 'Social Studies') {
            streamBadgeClass = "bg-amber-50 text-amber-900 border-amber-200/80";
