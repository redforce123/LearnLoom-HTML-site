const streams = [
  { id: 'all', label: 'All Subjects', count: papers.length },
  { id: 'computer-science', label: 'Computer Science', match: 'Computer Science', count: papers.filter(p => p.stream === 'Computer Science').length },
  { id: 'english', label: 'English', match: 'English Language', count: papers.filter(p => p.stream === 'English Language').length },
