];

const categories = [
  { id: 'all', label: 'All Papers', count: papers.length },
  { id: 'primary-1-3', label: 'Primary (Grades 1-3)', count: papers.filter(p => p.category === 'primary-1-3').length },
  { id: 'primary-4-5', label: 'Primary (Grades 4-5)', count: papers.filter(p => p.category === 'primary-4-5').length },
