---
import BaseLayout from '../layouts/BaseLayout.astro';

// Structured metadata for all 11 Olympiad Question Papers
const papers = [
  // Primary School (Grades 4-5)
  {
    id: 'grade-04-final',
    title: 'Grade 4 Olympiad Final Examination Paper',
    grade: 'Grade 4',
    category: 'primary',
    categoryLabel: 'Primary School (Grades 4-5)',
    stream: 'General',
    subjects: ['Mathematics', 'General Science'],
    fileUrl: '/resources/Olympiad_Question_Bank/Primary_School (Grades 4-5)/Olympiad_Grade-04_Final.pdf',
    fileName: 'Olympiad_Grade-04_Final.pdf',
    fileSize: '378 KB',
    description: 'Comprehensive Olympiad final assessment covering essential foundational mathematics, numerical patterns, and elementary science reasoning.',
    year: 'Official Final Set',
    popular: true
  },
  {
    id: 'grade-05-set-01',
    title: 'Grade 5 Olympiad Practice Paper (Set 1)',
    grade: 'Grade 5',
    category: 'primary',
    categoryLabel: 'Primary School (Grades 4-5)',
    stream: 'General',
    subjects: ['Mathematics', 'Logical Reasoning'],
    fileUrl: '/resources/Olympiad_Question_Bank/Primary_School (Grades 4-5)/Olympiad_Grade-05_Set-01.pdf',
    fileName: 'Olympiad_Grade-05_Set-01.pdf',
    fileSize: '443 KB',
    description: 'Curated problem set testing intermediate arithmetic, fractions, pattern recognition, spatial reasoning, and critical problem solving.',
    year: 'Practice Set 01',
    popular: false
  },
  {
    id: 'grade-05-set-02',
    title: 'Grade 5 Olympiad Practice Paper (Set 2)',
    grade: 'Grade 5',
    category: 'primary',
    categoryLabel: 'Primary School (Grades 4-5)',
    stream: 'General',
    subjects: ['Mathematics', 'General Science'],
    fileUrl: '/resources/Olympiad_Question_Bank/Primary_School (Grades 4-5)/Olympiad_Grade-05_Set-02.pdf',
    fileName: 'Olympiad_Grade-05_Set-02.pdf',
    fileSize: '443 KB',
    description: 'Advanced practice questions designed for competitive exam readiness, scientific methodology, and analytical deduction.',
    year: 'Practice Set 02',
    popular: false
  },

  // Middle School (Grade 8)
  {
    id: 'grade-08',
    title: 'Grade 8 Olympiad Question Paper',
    grade: 'Grade 8',
    category: 'middle',
    categoryLabel: 'Middle School (Grade 8)',
    stream: 'General',
    subjects: ['Mathematics', 'Science'],
    fileUrl: '/resources/Olympiad_Question_Bank/Middle_School (Grade 8)/Olympiad_Grade-08.pdf',
    fileName: 'Olympiad_Grade-08.pdf',
    fileSize: '342 KB',
    description: 'Challenging middle-school olympiad questions covering algebraic equations, geometric theorems, physics motion, and chemical fundamentals.',
    year: 'Complete Paper',
    popular: true
  },

  // Secondary School (Grades 9-10) - General Science & Maths
  {
    id: 'grade-09-general',
    title: 'Grade 9 Olympiad Paper - Science & Mathematics',
    grade: 'Grade 9',
    category: 'secondary',
    categoryLabel: 'Secondary School (Grades 9-10)',
    stream: 'General Science & Maths',
    subjects: ['Science', 'Mathematics'],
    fileUrl: '/resources/Olympiad_Question_Bank/Secondary_School (Grades 9-10)/General_Science_Maths/Olympiad_Grade-09_General.pdf',
    fileName: 'Olympiad_Grade-09_General.pdf',
    fileSize: '4.1 MB',
    description: 'Full question bank with extensive diagrams, real-world science applications, coordinate geometry, and rigorous analytical problems.',
    year: 'Comprehensive Paper',
    popular: true
  },
  {
    id: 'grade-10-general',
    title: 'Grade 10 Olympiad Paper - Science & Mathematics',
    grade: 'Grade 10',
    category: 'secondary',
    categoryLabel: 'Secondary School (Grades 9-10)',
    stream: 'General Science & Maths',
    subjects: ['Science', 'Mathematics'],
    fileUrl: '/resources/Olympiad_Question_Bank/Secondary_School (Grades 9-10)/General_Science_Maths/Olympiad_Grade-10_General.pdf',
    fileName: 'Olympiad_Grade-10_General.pdf',
    fileSize: '381 KB',
    description: 'Rigorous grade 10 test papers covering trigonometry, quadratic formulas, electricity, magnetism, optics, and chemical equations.',
    year: 'Standard Olympiad',
    popular: false
  },
  {
    id: 'grade-10-final',
    title: 'Grade 10 Olympiad Final Championship Paper',
    grade: 'Grade 10',
    category: 'secondary',
    categoryLabel: 'Secondary School (Grades 9-10)',
    stream: 'General Science & Maths',
    subjects: ['Science', 'Mathematics', 'Aptitude'],
    fileUrl: '/resources/Olympiad_Question_Bank/Secondary_School (Grades 9-10)/General_Science_Maths/Olympiad_Grade-10_Final.pdf',
    fileName: 'Olympiad_Grade-10_Final.pdf',
    fileSize: '397 KB',
    description: 'Championship-tier final examination paper benchmarked against international Junior Science and Mathematics Olympiad standards.',
    year: 'Championship Final',
    popular: true
  },

  // Secondary School (Grades 9-10) - Social Studies
  {
    id: 'grade-09-social',
    title: 'Grade 9 Social Studies Olympiad Paper',
    grade: 'Grade 9',
    category: 'secondary',
    categoryLabel: 'Secondary School (Grades 9-10)',
    stream: 'Social Studies',
    subjects: ['Social Studies', 'History', 'Civics', 'Geography'],
    fileUrl: '/resources/Olympiad_Question_Bank/Secondary_School (Grades 9-10)/Social_Studies/Olympiad_Grade-09_Social-Studies.pdf',
    fileName: 'Olympiad_Grade-09_Social-Studies.pdf',
    fileSize: '330 KB',
    description: 'Specialized humanities examination focusing on world history, geographical topography, democratic institutions, and economic concepts.',
    year: 'Social Studies Focus',
    popular: false
  },
  {
    id: 'grade-10-social',
    title: 'Grade 10 Social Studies Olympiad Paper',
    grade: 'Grade 10',
    category: 'secondary',
    categoryLabel: 'Secondary School (Grades 9-10)',
    stream: 'Social Studies',
    subjects: ['Social Studies', 'Global Politics', 'Economics'],
    fileUrl: '/resources/Olympiad_Question_Bank/Secondary_School (Grades 9-10)/Social_Studies/Olympiad_Grade-10_Social-Studies.pdf',
    fileName: 'Olympiad_Grade-10_Social-Studies.pdf',
    fileSize: '393 KB',
    description: 'Comprehensive social sciences evaluation paper testing global governance, contemporary world history, resources, and fiscal development.',
    year: 'Social Studies Focus',
    popular: false
  },

  // Senior Secondary (Grades 11-12)
  {
    id: 'grade-11',
    title: 'Grade 11 Senior Olympiad Paper',
    grade: 'Grade 11',
    category: 'senior',
    categoryLabel: 'Senior Secondary (Grades 11-12)',
    stream: 'Advanced STEM',
    subjects: ['Advanced Mathematics', 'Physics', 'Chemistry'],
    fileUrl: '/resources/Olympiad_Question_Bank/Senior_Secondary (Grades 11-12)/Olympiad_Grade-11.pdf',
    fileName: 'Olympiad_Grade-11.pdf',
    fileSize: '381 KB',
    description: 'Advanced pre-college competitive Olympiad exam targeting calculus fundamentals, classical mechanics, chemical bonding, and analytical proofs.',
    year: 'Senior Division',
    popular: true
  },
  {
    id: 'grade-12',
    title: 'Grade 12 Senior Olympiad Final Paper',
    grade: 'Grade 12',
    category: 'senior',
    categoryLabel: 'Senior Secondary (Grades 11-12)',
    stream: 'Advanced STEM',
    subjects: ['Advanced STEM', 'Higher Mathematics', 'Modern Physics'],
    fileUrl: '/resources/Olympiad_Question_Bank/Senior_Secondary (Grades 11-12)/Olympiad_Grade-12.pdf',
    fileName: 'Olympiad_Grade-12.pdf',
    fileSize: '383 KB',
    description: 'Senior-tier Olympiad assessment for university-bound students and international STEM Olympiad contenders. In-depth theoretical problems.',
    year: 'Senior Division Final',
    popular: true
  }
];

const categories = [
  { id: 'all', label: 'All Papers', count: 11 },
  { id: 'primary', label: 'Primary (Grades 4-5)', count: 3 },
  { id: 'middle', label: 'Middle School (Grade 8)', count: 1 },
  { id: 'secondary', label: 'Secondary (Grades 9-10)', count: 5 },
  { id: 'senior', label: 'Senior (Grades 11-12)', count: 2 }
];

// Rich SEO Metadata for Google
const pageTitle = "Free Olympiad Question Bank & Past Papers (Grades 4-12) | LearnLoom";
const pageDescription = "Download free Olympiad question papers, sample tests, and past exams for Grades 4 to 12. Covers Mathematics, General Science, and Social Studies in PDF format with direct free downloads.";
const canonicalUrl = "https://www.learnloomglobal.com/resources";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Schema.org LearningResource & ItemList for Google Rich Snippets -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "LearnLoom Free Olympiad Question Bank",
    "description": pageDescription,
    "url": canonicalUrl,
    "provider": {
      "@type": "EducationalOrganization",
      "name": "LearnLoom",
      "url": "https://www.learnloomglobal.com"
    },
    "mainEntity": {
      "@type": "ItemList",
      "name": "Free Olympiad Exam Papers (Grades 4-12)",
      "itemListElement": papers.map((paper, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "DigitalDocument",
          "name": paper.title,
          "description": paper.description,
          "encodingFormat": "application/pdf",
          "url": `https://www.learnloomglobal.com${encodeURI(paper.fileUrl)}`,
          "educationalLevel": paper.grade,
          "inLanguage": "en",
          "isAccessibleForFree": true
        }
      }))
    }
  })} />

  <main class="container mx-auto px-4 py-8 flex-grow">
    <!-- Hero Section -->
    <section class="pt-6 pb-12 text-center relative">
      <!-- Ambient Glows -->
      <div class="absolute top-0 left-1/4 w-[420px] h-[420px] bg-pink-100/30 rounded-full filter blur-3xl -z-10 pointer-events-none"></div>
      <div class="absolute top-10 right-1/4 w-[350px] h-[350px] bg-amber-100/30 rounded-full filter blur-3xl -z-10 pointer-events-none"></div>

      <!-- Badge -->
      <div class="inline-flex items-center space-x-2 bg-pink-50 border border-pink-200/60 px-4 py-1.5 rounded-full text-xs font-bold text-[#EA0264] mb-4 shadow-sm">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
        </svg>
        <span>Free Educational Downloads • Grades 4 to 12</span>
      </div>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 mb-4 tracking-tight max-w-4xl mx-auto">
        Free Olympiad <span class="bg-gradient-to-r from-[#FF2E93] to-[#EA0264] bg-clip-text text-transparent">Question Bank</span> & Past Papers
      </h1>
      
      <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed mb-8">
        Accelerate your competitive exam readiness. Download authentic Olympiad test papers, practice sets, and championship assessments for Mathematics, Science, and Social Studies.
      </p>

      <!-- Search & Filters Container -->
      <div class="max-w-3xl mx-auto bg-white/80 backdrop-blur-md p-3 md:p-4 rounded-3xl border border-slate-200/60 shadow-xl shadow-slate-200/40">
        <!-- Live Search Input -->
        <div class="relative mb-3">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input 
            type="text" 
            id="resource-search" 
            placeholder="Search papers by grade (e.g. Grade 10), subject (e.g. Science), or keyword..." 
            class="w-full pl-11 pr-10 py-3 rounded-2xl bg-slate-50 border border-slate-200/80 text-sm md:text-base text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#EA0264] focus:border-transparent transition-all"
            autocomplete="off"
          />
          <button 
            id="clear-search" 
            class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600"
            title="Clear search"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Grade Category Filter Pills -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
          {categories.map((cat) => (
            <button
              type="button"
              data-category-filter={cat.id}
              class={`filter-tab-btn px-4 py-2 rounded-xl text-xs md:text-sm font-semibold transition-all duration-200 ${
                cat.id === 'all'
                  ? 'bg-gradient-to-r from-[#FF2E93] to-[#EA0264] text-white shadow-md shadow-pink-500/20 active-tab'
                  : 'bg-slate-100 text-slate-600 hover:bg-slate-200/80 hover:text-slate-900'
              }`}
            >
              <span>{cat.label}</span>
              <span class={`ml-1.5 text-xs px-1.5 py-0.5 rounded-full ${cat.id === 'all' ? 'bg-white/25 text-white' : 'bg-slate-200 text-slate-600'}`}>
                {cat.count}
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Stats Bar -->
    <section class="max-w-4xl mx-auto mb-10 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="bg-white/70 backdrop-blur-sm border border-slate-100 p-4 rounded-2xl shadow-sm">
        <div class="text-2xl font-extrabold text-[#EA0264]">11</div>
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Official Papers</div>
      </div>
      <div class="bg-white/70 backdrop-blur-sm border border-slate-100 p-4 rounded-2xl shadow-sm">
        <div class="text-2xl font-extrabold text-slate-900">Grades 4-12</div>
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Grade Coverage</div>
      </div>
      <div class="bg-white/70 backdrop-blur-sm border border-slate-100 p-4 rounded-2xl shadow-sm">
        <div class="text-2xl font-extrabold text-[#EA0264]">100% Free</div>
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">PDF Downloads</div>
      </div>
      <div class="bg-white/70 backdrop-blur-sm border border-slate-100 p-4 rounded-2xl shadow-sm">
        <div class="text-2xl font-extrabold text-slate-900">3 Streams</div>
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-1">Maths, Science & SST</div>
      </div>
    </section>

    <!-- Question Papers Grid -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight" id="results-heading">All Question Papers</h2>
          <p class="text-sm text-slate-500" id="results-count">Showing all 11 examination papers</p>
        </div>
      </div>

      <div id="papers-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {papers.map((paper) => (
          <article 
            class="paper-card bg-white/90 backdrop-blur-md rounded-2xl border border-slate-200/70 p-6 flex flex-col justify-between hover:shadow-xl hover:border-pink-300 hover:-translate-y-1 transition-all duration-300 relative group"
            data-category={paper.category}
            data-grade={paper.grade.toLowerCase()}
            data-title={paper.title.toLowerCase()}
            data-subjects={paper.subjects.join(' ').toLowerCase()}
            data-stream={paper.stream.toLowerCase()}
          >
            <!-- Top Tag Row -->
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold bg-pink-50 text-[#EA0264] border border-pink-200/50">
                  {paper.grade}
                </span>

                <div class="flex items-center space-x-1.5">
                  {paper.popular && (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800">
                      Popular
                    </span>
                  )}
                  <span class="text-[11px] font-semibold text-slate-400 bg-slate-100 px-2 py-0.5 rounded-md">
                    {paper.fileSize}
                  </span>
                </div>
              </div>

              <!-- Stream Tag if present -->
              {paper.stream !== 'General' && (
                <div class="mb-2">
                  <span class="text-[11px] font-semibold text-indigo-700 bg-indigo-50 border border-indigo-100 px-2.5 py-0.5 rounded-full">
                    {paper.stream}
                  </span>
                </div>
              )}

              <!-- Title -->
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#EA0264] transition-colors leading-snug mb-2">
                {paper.title}
              </h3>

              <!-- Description -->
              <p class="text-xs md:text-sm text-slate-600 leading-relaxed mb-4 line-clamp-3">
                {paper.description}
              </p>

              <!-- Subject Pills -->
              <div class="flex flex-wrap gap-1.5 mb-5">
                {paper.subjects.map((subj) => (
                  <span class="text-[11px] font-medium bg-slate-100 text-slate-700 px-2.5 py-0.5 rounded-md">
                    {subj}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Actions -->
            <div class="pt-4 border-t border-slate-100 flex items-center gap-2.5">
              <!-- Download Button -->
              <a 
                href={encodeURI(paper.fileUrl)} 
                download={paper.fileName}
                class="flex-1 inline-flex items-center justify-center space-x-2 bg-gradient-to-r from-[#FF2E93] to-[#EA0264] text-white text-xs md:text-sm font-bold py-2.5 px-4 rounded-xl shadow-md shadow-pink-500/10 hover:shadow-lg hover:shadow-pink-500/20 active:scale-[0.98] transition-all"
                aria-label={`Download ${paper.title} PDF`}
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                <span>Download PDF</span>
              </a>

              <!-- Preview Button -->
              <a 
                href={encodeURI(paper.fileUrl)} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center p-2.5 rounded-xl border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-100 hover:border-slate-300 transition-colors"
                title={`Preview ${paper.title} in new tab`}
                aria-label={`Preview ${paper.title} in new tab`}
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- No Results State (hidden by default) -->
      <div id="no-results" class="hidden text-center py-16 bg-white/70 backdrop-blur-md rounded-3xl border border-slate-100 max-w-md mx-auto my-6">
        <div class="mx-auto w-14 h-14 bg-pink-50 rounded-2xl flex items-center justify-center text-[#EA0264] mb-4">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-1">No question papers found</h3>
        <p class="text-sm text-slate-500 mb-4">Try searching with a different grade, subject, or reset your filters.</p>
        <button 
          id="reset-filters" 
          class="inline-flex items-center space-x-1.5 text-xs font-bold text-[#EA0264] bg-pink-50 px-4 py-2 rounded-xl hover:bg-pink-100 transition-colors"
        >
          <span>Reset Search & Filters</span>
        </button>
      </div>
    </section>

    <!-- Tutoring Help Banner (Conversion Hook) -->
    <section class="max-w-5xl mx-auto mb-20 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-950 text-white rounded-3xl p-8 md:p-12 relative overflow-hidden shadow-2xl border border-slate-800">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-pink-500/20 rounded-full filter blur-3xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="text-center md:text-left max-w-xl">
          <span class="inline-block bg-pink-500/20 text-pink-300 text-xs font-bold px-3 py-1 rounded-full mb-3 border border-pink-500/30">
            Need Guided Exam Support?
          </span>
          <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-3">
            Solve Challenging Olympiad Problems with Expert 1-on-1 Mentors
          </h2>
          <p class="text-slate-300 text-sm md:text-base leading-relaxed">
            Don't let complex reasoning questions hold your child back. LearnLoom pairs students with elite mentors for personalized Olympiad prep, conceptual mastery, and mock test debriefs.
          </p>
        </div>
        <div class="flex-shrink-0">
          <a 
            href="/BookDemo" 
            class="inline-flex items-center space-x-2 bg-gradient-to-r from-[#FF2E93] to-[#EA0264] text-white text-base font-bold py-3.5 px-8 rounded-full shadow-lg shadow-pink-500/25 hover:shadow-xl hover:shadow-pink-500/35 hover:scale-105 active:scale-95 transition-all"
          >
            <span>Book a Free 1-on-1 Demo</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Client-side Interactive Filter & Search Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('resource-search');
      const clearSearchBtn = document.getElementById('clear-search');
      const filterButtons = document.querySelectorAll('[data-category-filter]');
      const paperCards = document.querySelectorAll('.paper-card');
      const noResults = document.getElementById('no-results');
      const resetBtn = document.getElementById('reset-filters');
      const resultsHeading = document.getElementById('results-heading');
      const resultsCount = document.getElementById('results-count');

      let currentCategory = 'all';
      let currentQuery = '';

      function filterPapers() {
        let visibleCount = 0;
        const query = currentQuery.trim().toLowerCase();

        paperCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          const title = card.getAttribute('data-title') || '';
          const grade = card.getAttribute('data-grade') || '';
          const subjects = card.getAttribute('data-subjects') || '';
          const stream = card.getAttribute('data-stream') || '';

          const matchesCategory = (currentCategory === 'all' || cardCategory === currentCategory);
          const matchesQuery = !query || 
            title.includes(query) || 
            grade.includes(query) || 
            subjects.includes(query) || 
            stream.includes(query);

          if (matchesCategory && matchesQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Update count & heading
        if (resultsCount) {
          resultsCount.textContent = `Showing ${visibleCount} of ${paperCards.length} examination papers`;
        }

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }

        // Toggle clear search button visibility
        if (clearSearchBtn) {
          if (query.length > 0) {
            clearSearchBtn.classList.remove('hidden');
          } else {
            clearSearchBtn.classList.add('hidden');
          }
        }
      }

      // Filter Tab buttons click handler
      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => {
            b.classList.remove('bg-gradient-to-r', 'from-[#FF2E93]', 'to-[#EA0264]', 'text-white', 'shadow-md', 'shadow-pink-500/20', 'active-tab');
            b.classList.add('bg-slate-100', 'text-slate-600');
            const badge = b.querySelector('span:last-child');
            if (badge) {
              badge.classList.remove('bg-white/25', 'text-white');
              badge.classList.add('bg-slate-200', 'text-slate-600');
            }
          });

          btn.classList.remove('bg-slate-100', 'text-slate-600');
          btn.classList.add('bg-gradient-to-r', 'from-[#FF2E93]', 'to-[#EA0264]', 'text-white', 'shadow-md', 'shadow-pink-500/20', 'active-tab');
          const badge = btn.querySelector('span:last-child');
          if (badge) {
            badge.classList.remove('bg-slate-200', 'text-slate-600');
            badge.classList.add('bg-white/25', 'text-white');
          }

          currentCategory = btn.getAttribute('data-category-filter') || 'all';
          filterPapers();
        });
      });

      // Search input handler
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value;
          filterPapers();
        });
      }

      // Clear search button
      if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', () => {
          if (searchInput) {
            searchInput.value = '';
            currentQuery = '';
            filterPapers();
            searchInput.focus();
          }
        });
      }

      // Reset button in empty state
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          const allTab = document.querySelector('[data-category-filter="all"]');
          if (allTab) allTab.click();
        });
      }
    });
  </script>
</BaseLayout>
