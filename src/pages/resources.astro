<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Schema.org LearningResource, ItemList & FAQPage for Google Rich Snippets -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "LearnLoom Free Olympiad Question Bank",
    "description": pageDescription,
    "url": canonicalUrl,
    "provider": {
      "@type": "EducationalOrganization",
      "name": "LearnLoom",
      "url": "https://www.learnloomglobal.com"
    },
    "mainEntity": {
      "@type": "ItemList",
      "name": "Free Olympiad Exam Papers (Grades 1-12)",
      "numberOfItems": papers.length,
      "itemListElement": papers.map((paper, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "DigitalDocument",
          "name": paper.title,
          "description": paper.description,
          "encodingFormat": "application/pdf",
          "url": `https://www.learnloomglobal.com${encodeURI(paper.fileUrl)}`,
          "educationalLevel": paper.grade,
          "inLanguage": paper.stream.includes('Hindi') ? 'hi' : 'en',
          "isAccessibleForFree": true,
          "keywords": paper.subjects.join(', ')
        }
      }))
    }
  })} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  })} />

  <main class="container mx-auto px-4 py-8 flex-grow">
    <!-- Hero Section -->
    <section class="pt-6 pb-10 text-center relative">
