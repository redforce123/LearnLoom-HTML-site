              <span class="ml-4 flex-shrink-0 w-6 h-6 rounded-full bg-slate-100 group-hover:bg-pink-50 group-open:rotate-180 flex items-center justify-center transition-transform duration-200 text-slate-500 group-hover:text-[#EA0264]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
