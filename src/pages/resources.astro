    </section>

    <!-- Tutoring Help Banner (Conversion Hook) -->
    <section class="max-w-5xl mx-auto mb-16 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-950 text-white rounded-3xl p-8 md:p-12 relative overflow-hidden shadow-2xl border border-slate-800">
